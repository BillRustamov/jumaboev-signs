# Optional. When unset, `npm run bot` starts a local mock Telegram conversation.
TELEGRAM_BOT_TOKEN=

# Public shop origin for Telegram Mini App / pay links.
# Local next: http://127.0.0.1:43147
# Live: https://www.usprint.app
APP_URL=https://www.usprint.app

# Optional. Web and Telegram tickets are forwarded here as a shop ping.
TELEGRAM_SHOP_CHAT_ID=

# Resend — same mail service as AK Photo. Unset = no customer email (orders still save).
# Local: put the key in this file. Live: npx wrangler secret put RESEND_API_KEY
RESEND_API_KEY=
# Optional alias used by AK Photo's API. Either name works.
# RESEND_KEY=
# Must be a verified Resend sender. Until usprint.app is verified, use the onboarding address
# from the Resend dashboard (it can only send to your Resend login email).
RESEND_FROM_EMAIL=usprint <orders@usprint.app>
# Optional. Shop inbox copy of every new ticket (in addition to Telegram).
RESEND_SHOP_TO=

# Test-mode only. Live keys (sk_live / rk_live) are refused.
# Unset = checkout disabled. Tickets stay unpaid. Never fake PAID.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
