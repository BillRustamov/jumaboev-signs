# Optional. When unset, `npm run bot` starts a local mock Telegram conversation.
TELEGRAM_BOT_TOKEN=

# Used by the Telegram bot to post confirmed orders into the web app.
APP_URL=http://127.0.0.1:43147

# Optional. Web and Telegram tickets are forwarded here as a shop ping.
TELEGRAM_SHOP_CHAT_ID=

# Test-mode only. Live keys (sk_live / rk_live) are refused.
# Unset = checkout disabled. Tickets stay unpaid. Never fake PAID.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
